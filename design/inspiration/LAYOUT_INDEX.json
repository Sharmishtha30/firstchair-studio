{
  "version": 1,
  "scope": "98 static placements; not performance-tested; carousel references remain in GOLDEN_SET.md",
  "families": [
    {
      "id": "hero",
      "name": "Image and headline",
      "choose_when": "A strong product, person, setting or outcome-related image is available.",
      "composition": "One dominant image; short headline in a clear area; one supporting line; quiet brand mark and action.",
      "copy_pattern": "Name a recognisable situation or desire, then explain the product connection.",
      "requires": "A relevant image and supported product proposition.",
      "fallback": "Use a typography-led explanation when suitable photography is absent.",
      "cross_industry_examples": "A software screenshot with a specific workflow frustration; a service scene with a relevant customer question."
    },
    {
      "id": "annotation",
      "name": "Product with labelled details",
      "choose_when": "The offer has concrete features worth pointing out.",
      "composition": "Large product or interface image; 2–4 anchored labels; headline; one next step.",
      "copy_pattern": "Feature → what it helps the audience do. Each label adds new information.",
      "requires": "Accurate product image or interface capture and documented features.",
      "fallback": "Use a short feature list if the details cannot be shown accurately.",
      "cross_industry_examples": "Label parts of a software dashboard, a course curriculum or a physical product."
    },
    {
      "id": "comparison",
      "name": "Side-by-side comparison",
      "choose_when": "The audience must choose between two supported alternatives.",
      "composition": "Two aligned columns; identical comparison criteria; concise conclusion.",
      "copy_pattern": "Explain the meaningful tradeoff using matching criteria.",
      "requires": "Comparable facts with sources and consistent basis; authentic evidence for outcome comparisons.",
      "fallback": "Use a decision checklist when comparison evidence is incomplete.",
      "cross_industry_examples": "Manual versus documented automated steps; two plans; actual service options."
    },
    {
      "id": "diagram",
      "name": "One-idea diagram",
      "choose_when": "A relationship, overlap or set of use occasions is the main message.",
      "composition": "Venn circles, wheel, gauge or simple relationship drawing; short labels; central explanation.",
      "copy_pattern": "State the relationship first, then label it with concrete language.",
      "requires": "Supported relationships; measurements only when sourced.",
      "fallback": "Use a two-part text explanation if the diagram adds no meaning.",
      "cross_industry_examples": "Overlapping team needs, a hiring process relationship or service use occasions."
    },
    {
      "id": "sequence",
      "name": "Steps and progression",
      "choose_when": "The website describes an ordered process or documented journey.",
      "composition": "Three or four stages with a clear reading direction; repeated visual treatment.",
      "copy_pattern": "Describe what happens at each step and why the next follows.",
      "requires": "Documented process; additional outcome evidence for any results timeline.",
      "fallback": "Show instructions rather than predicted outcomes.",
      "cross_industry_examples": "Onboarding, booking, project delivery, or a real case-study sequence."
    },
    {
      "id": "list",
      "name": "Checklist and numbered reasons",
      "choose_when": "Several concise criteria explain a decision or hesitation.",
      "composition": "One useful title; 3–5 items with consistent markers; brief action.",
      "copy_pattern": "Each item answers the title and earns its place with a distinct point.",
      "requires": "Supported criteria, features or reasons; no invented diagnostic scoring.",
      "fallback": "Reduce to one useful idea if there are not enough distinct points.",
      "cross_industry_examples": "Buying criteria for software, questions before hiring a service, or reasons to join a programme."
    },
    {
      "id": "notes",
      "name": "Notes, letters and physical documents",
      "choose_when": "A personal brand voice or an objection benefits from a direct written explanation.",
      "composition": "Note, letter, whiteboard, diary or receipt-inspired surface; clear heading; short paragraphs or bullets.",
      "copy_pattern": "Acknowledge the concern → explain with specifics → next step.",
      "requires": "Brand-authored explanation or authentic permitted personal material.",
      "fallback": "Use a plain branded letter without simulated customer provenance.",
      "cross_industry_examples": "Founder explanation, pricing rationale, project checklist or service breakdown."
    },
    {
      "id": "conversation",
      "name": "Questions and conversation",
      "choose_when": "The audience has a clear question or objection.",
      "composition": "A few question/answer blocks with obvious reading order; limited interface decoration.",
      "copy_pattern": "Natural question → helpful answer → likely follow-up → grounded resolution.",
      "requires": "Real messages when presented as real; otherwise clearly brand-authored Q&A.",
      "fallback": "Use a branded FAQ card without identities, timestamps or social badges.",
      "cross_industry_examples": "Software objections, service qualification, product usage or membership questions."
    },
    {
      "id": "proof",
      "name": "Review, quote and evidence",
      "choose_when": "There is a useful, attributable piece of evidence.",
      "composition": "One quote or statistic; visible context/source; relevant image if available.",
      "copy_pattern": "Keep the actual meaning and qualifiers; explain relevance without exaggeration.",
      "requires": "A real permitted review or sourced statistic with context.",
      "fallback": "Use a factual product explanation when no proof exists.",
      "cross_industry_examples": "A real service review, documented case result or accurately quoted customer experience."
    },
    {
      "id": "editorial",
      "name": "Editorial feature",
      "choose_when": "The website contains a meaningful insight or article worth summarising.",
      "composition": "Headline; brief explanation; strong image or product grid; clear brand attribution.",
      "copy_pattern": "Observation → explanation → why it matters → next step.",
      "requires": "Source material supporting the angle; real attribution for external coverage.",
      "fallback": "Use a brand-authored explainer without publication branding.",
      "cross_industry_examples": "Industry insight, educational article, product announcement or newsletter extract."
    },
    {
      "id": "offer",
      "name": "Offer and announcement",
      "choose_when": "There is an actual offer, launch, bundle, guarantee or availability update.",
      "composition": "Prominent offer or news; product/context; essential terms; one action.",
      "copy_pattern": "What is available → why relevant → accurate conditions → action.",
      "requires": "Current terms and destination; evidence for scarcity, savings or guarantees.",
      "fallback": "Use a non-urgent product introduction if the offer is not verified.",
      "cross_industry_examples": "A course intake, service package, software trial or real product promotion."
    },
    {
      "id": "illustration",
      "name": "Illustration and visual metaphor",
      "choose_when": "A clear idea benefits from a drawing, character or unexpected scene.",
      "composition": "One visual concept; restrained headline; recognisable product connection.",
      "copy_pattern": "Make the metaphor understandable before adding a joke or twist.",
      "requires": "Suitable original/authorised artwork; factual support for implied claims.",
      "fallback": "Use a simple diagram or available photo if artwork is unavailable.",
      "cross_industry_examples": "An illustrated workflow problem, role-based scenario or metaphor for a documented benefit."
    },
    {
      "id": "grid",
      "name": "Product or information grid",
      "choose_when": "Several variants, bundle items or information groups need comparison at a glance.",
      "composition": "2×2 grid or a small set of consistent cards; common crop, type hierarchy and labels.",
      "copy_pattern": "Explain meaningful differences with parallel short labels.",
      "requires": "Real variants, contents, prices or grouped information.",
      "fallback": "Use a single-item hero when there is only one meaningful option.",
      "cross_industry_examples": "Software plans, course modules, service packages or product variants."
    }
  ],
